{
  "name": "@monocloud/management-js",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint:es -- --fix && turbo run lint:ts",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only --engine-strict=false",
    "changeset:publish": "changeset publish --no-git-tag",
    "gen:docs": "rimraf docs && typedoc --options ./docs-gen/typedoc.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "tsdown": "0.23.0",
    "turbo": "2.11.5",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=11"
  },
  "packageManager": "pnpm@12.6.0"
}
